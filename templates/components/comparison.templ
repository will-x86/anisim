package components

import (
	"fmt"
	"github.com/will-x86/anisim/internal/analyzer"
	"github.com/will-x86/anisim/internal/db"
	"github.com/will-x86/anisim/internal/types"
)

templ ComparisonCard(c db.Comparison) {
	<div class="border p-4">
		<div class="flex justify-between items-center">
			<div>
				<span class="font-medium">{ c.CreatorUsername }</span>
				<span class="text-gray-400 mx-2">vs</span>
				<span class="font-medium">{ c.ComparatorUsername }</span>
			</div>
			<a href={ templ.SafeURL(fmt.Sprintf("/comparisons/%d", c.ID)) } class="text-blue-600 hover:text-blue-800">
				View
			</a>
		</div>
	</div>
}

templ CreateComparisonForm() {
	<form method="POST" action="/comparisons" class="border p-4">
		<h2 class="font-semibold mb-4">Create Comparison</h2>
		<div class="space-y-2">
			<input
				type="text"
				name="creator_username"
				placeholder="Your AniList username"
				required
				class="w-full border p-2"
			/>
			<input
				type="text"
				name="comparator_username"
				placeholder="Their AniList username"
				required
				class="w-full border p-2"
			/>
			<button type="submit" class="w-full bg-blue-600 text-white p-2 hover:bg-blue-700">
				Create
			</button>
		</div>
	</form>
}

templ ComparisonView(c types.Comparison, result analyzer.ComparisonResult) {
	<div class="bg-white rounded-lg shadow-md p-6 mb-8">
		<h1 class="text-3xl font-bold mb-6 text-center">Comparison Results</h1>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
			<div class="border rounded-lg p-6">
				<div class="flex items-center gap-4 mb-4">
					<img src={ c.Creator.Avatar.Medium } alt={ c.Creator.Name } class="w-20 h-20 rounded-full"/>
					<div>
						<h2 class="text-2xl font-bold">{ c.Creator.Name }</h2>
					</div>
				</div>
				<div class="space-y-2 text-sm">
					<div><span class="font-medium">Episodes:</span> { fmt.Sprintf("%d", c.Creator.Statistics.Anime.EpisodesWatched) }</div>
					<div><span class="font-medium">Minutes:</span> { fmt.Sprintf("%d", c.Creator.Statistics.Anime.MinutesWatched) }</div>
					<div><span class="font-medium">Chapters:</span> { fmt.Sprintf("%d", c.Creator.Statistics.Manga.ChaptersRead) }</div>
					<div><span class="font-medium">Mean Score:</span> { fmt.Sprintf("%.2f", c.Creator.Statistics.Manga.MeanScore) }</div>
				</div>
			</div>
			<div class="border rounded-lg p-6">
				<div class="flex items-center gap-4 mb-4">
					<img src={ c.Comparator.Avatar.Medium } alt={ c.Comparator.Name } class="w-20 h-20 rounded-full"/>
					<div>
						<h2 class="text-2xl font-bold">{ c.Comparator.Name }</h2>
					</div>
				</div>
				<div class="space-y-2 text-sm">
					<div><span class="font-medium">Episodes:</span> { fmt.Sprintf("%d", c.Comparator.Statistics.Anime.EpisodesWatched) }</div>
					<div><span class="font-medium">Minutes:</span> { fmt.Sprintf("%d", c.Comparator.Statistics.Anime.MinutesWatched) }</div>
					<div><span class="font-medium">Chapters:</span> { fmt.Sprintf("%d", c.Comparator.Statistics.Manga.ChaptersRead) }</div>
					<div><span class="font-medium">Mean Score:</span> { fmt.Sprintf("%.2f", c.Comparator.Statistics.Manga.MeanScore) }</div>
				</div>
			</div>
		</div>
	</div>
	<div class="bg-white rounded-lg shadow-md p-6 mb-8">
		<h2 class="text-2xl font-bold mb-6">📺 Shared Anime</h2>
		if len(result.SharedAnime) == 0 {
			<p class="text-gray-500 text-center py-8">No shared anime found</p>
		} else {
			for status, entries := range result.SharedAnime {
				if len(entries) > 0 {
					<div class="mb-8">
						<h3 class="text-xl font-semibold mb-4 capitalize">
							{ status }
							<span class="text-sm text-gray-500">({ fmt.Sprintf("%d", len(entries)) } shared)</span>
						</h3>
						<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
							for _, entry := range entries {
								<div class="border rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
									<img
										src={ entry.Media.CoverImage.Large }
										alt={ entry.Media.Title.Romaji }
										class="w-full h-48 object-cover border-2 border-green-500"
									/>
									<div class="p-3">
										<p class="font-medium text-sm mb-2 line-clamp-2" title={ entry.Media.Title.Romaji }>
											if entry.Media.Title.English != "" {
												{ entry.Media.Title.English }
											} else {
												{ entry.Media.Title.Romaji }
											}
										</p>
										<div class="flex justify-between text-xs gap-2">
											<!-- Creator Section -->
											<div class="flex items-center gap-1.5">
												<img
													src={ c.Creator.Avatar.Medium }
													alt={ c.Creator.Name }
													class="w-6 h-6 rounded-full object-cover"
												/>
												<div>
													<div class="font-medium">{ c.Creator.Name }</div>
													if entry.CreatorScore > 0 {
														if entry.CreatorScore >= 7 {
															<div class="text-green-600 font-semibold">⭐ { fmt.Sprintf("%.1f", entry.CreatorScore) }</div>
														} else if entry.CreatorScore >= 3 {
															<div class="text-gray-600 font-semibold">⭐ { fmt.Sprintf("%.1f", entry.CreatorScore) }</div>
														} else {
															<div class="text-red-600 font-semibold">⭐ { fmt.Sprintf("%.1f", entry.CreatorScore) }</div>
														}
													} else {
														<div class="text-gray-400">No score</div>
													}
												</div>
											</div>
											<!-- Comparator Section -->
											<div class="flex items-center gap-1.5 text-right">
												<div>
													<div class="font-medium">{ c.Comparator.Name }</div>
													if entry.ComparatorScore > 0 {
														if entry.ComparatorScore >= 7 {
															<div class="text-green-600 font-semibold">⭐ { fmt.Sprintf("%.1f", entry.ComparatorScore) }</div>
														} else if entry.ComparatorScore >= 3 {
															<div class="text-gray-600 font-semibold">⭐ { fmt.Sprintf("%.1f", entry.ComparatorScore) }</div>
														} else {
															<div class="text-red-600 font-semibold">⭐ { fmt.Sprintf("%.1f", entry.ComparatorScore) }</div>
														}
													} else {
														<div class="text-gray-400">No score</div>
													}
												</div>
												<img
													src={ c.Comparator.Avatar.Medium }
													alt={ c.Comparator.Name }
													class="w-6 h-6 rounded-full object-cover"
												/>
											</div>
										</div>
									</div>
								</div>
							}
						</div>
					</div>
				}
			}
		}
	</div>
	<div class="bg-white rounded-lg shadow-md p-6 mb-8">
		<h2 class="text-2xl font-bold mb-6">📚 Shared Manga</h2>
		if len(result.SharedManga) == 0 {
			<p class="text-gray-500 text-center py-8">No shared manga found</p>
		} else {
			for status, entries := range result.SharedManga {
				if len(entries) > 0 {
					<div class="mb-8">
						<h3 class="text-xl font-semibold mb-4 capitalize">
							{ status }
							<span class="text-sm text-gray-500">({ fmt.Sprintf("%d", len(entries)) } shared)</span>
						</h3>
						<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
							for _, entry := range entries {
								<div class="border rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
									<img
										src={ entry.Media.CoverImage.Large }
										alt={ entry.Media.Title.Romaji }
										class="w-full h-48 object-cover"
									/>
									<div class="p-3">
										<p class="font-medium text-sm mb-2 line-clamp-2" title={ entry.Media.Title.Romaji }>
											if entry.Media.Title.English != "" {
												{ entry.Media.Title.English }
											} else {
												{ entry.Media.Title.Romaji }
											}
										</p>
										<div class="flex justify-between text-xs text-gray-600">
											<div>
												<div class="font-medium">{ c.Creator.Name }</div>
												if entry.CreatorScore > 0 {
													<div>⭐ { fmt.Sprintf("%.1f", entry.CreatorScore) }</div>
												} else {
													<div class="text-gray-400">No score</div>
												}
											</div>
											<div class="text-right">
												<div class="font-medium">{ c.Comparator.Name }</div>
												if entry.ComparatorScore > 0 {
													<div>⭐ { fmt.Sprintf("%.1f", entry.ComparatorScore) }</div>
												} else {
													<div class="text-gray-400">No score</div>
												}
											</div>
										</div>
									</div>
								</div>
							}
						</div>
					</div>
				}
			}
		}
	</div>
	<div class="text-center text-sm text-gray-500">
		Comparison created: { c.Created.Format("January 2, 2006 at 3:04 PM") }
	</div>
}

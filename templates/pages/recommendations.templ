package pages

import (
	"fmt"
	"github.com/will-x86/anisim/internal/anilist/recommendation"
	"github.com/will-x86/anisim/internal/types"
	"github.com/will-x86/anisim/templates/layouts"
)

templ recommendationRow(rec recommendation.Recommendation) {
	{{
		url := "#"
		title := rec.MediaTitleEnglish
		if title == "" {
			title = rec.MediaTitleRomaji
		}
		if rec.MediaType == "anime" {
			url = fmt.Sprintf("https://anilist.co/anime/%d", rec.MediaID)
		} else {
			url = fmt.Sprintf("https://anilist.co/manga/%d", rec.MediaID)
		}
	}}
	<tr class="border-b hover:bg-gray-50 transition-colors">
		<td class="p-3">
			<a href={ templ.URL(url) } target="_blank" rel="noopener noreferrer" class="flex items-center gap-3">
				<img
					src={ rec.MediaCoverLarge }
					alt={ title }
					class="w-16 h-24 object-cover rounded-md shadow-sm"
				/>
				<div>
					<div class="font-medium mb-1">{ title }</div>
					<div class="text-xs text-gray-500">
						if len(rec.MatchedGenres) > 0 {
							<div class="mb-1">
								<span class="font-semibold">Genres you like:</span>
								for i, genre := range rec.MatchedGenres {
									if i > 0 {
										<span>, </span>
									}
									<span>{ genre }</span>
								}
							</div>
						}
						if len(rec.MatchedTags) > 0 {
							<div>
								<span class="font-semibold">Tags you like:</span>
								<div class="mt-1 space-y-1">
									for _, tag := range rec.MatchedTags {
										<details class="cursor-pointer">
											<summary class="text-blue-600 hover:text-blue-800 inline-flex items-center">
												<span class="mr-1">▶</span>
												<span>{ tag }</span>
											</summary>
											<div class="ml-4 mt-1 text-xs text-gray-600">
												if sources, ok := rec.TagSources[tag]; ok && len(sources) > 0 {
													<div class="space-y-0.5">
														for _, source := range sources {
															<div>• { source.MediaTitle } ({ fmt.Sprintf("%.1f", source.Score) })</div>
														}
													</div>
												} else {
													<div class="text-gray-400">No source data</div>
												}
											</div>
										</details>
									}
								</div>
							</div>
						}
					</div>
				</div>
			</a>
		</td>
		<td class="text-center p-3">
			<span class="text-green-600 font-bold text-lg">{ fmt.Sprintf("%.2f", rec.Score) }</span>
		</td>
		<td class="text-center p-3">
			<span class="text-sm text-gray-600">{ fmt.Sprintf("%.2f", rec.ComparatorScore) }</span>
		</td>
		<td class="text-center p-3">
			if rec.AverageScore > 0 {
				<span class="text-sm text-gray-600">{ fmt.Sprintf("%.1f", float64(rec.AverageScore)/10.0) }</span>
			} else {
				<span class="text-gray-400 text-sm">-</span>
			}
		</td>
		<td class="text-center p-3">
			<div class="text-xs text-gray-500">
				<div>A:{ fmt.Sprintf("%.2f", rec.AlignmentScore) } Q:{ fmt.Sprintf("%.2f", rec.QualityScore) } R:{ fmt.Sprintf("%.2f", rec.RelevanceScore) }</div>
				if len(rec.MatchedGenres) > 0 || len(rec.MatchedTags) > 0 {
					<div class="mt-1 text-blue-600">
						G:{ fmt.Sprintf("%.2f", rec.GenreMatch) } T:{ fmt.Sprintf("%.2f", rec.TagMatch) }
					</div>
				}
			</div>
		</td>
	</tr>
}

templ Recommendations(c types.Comparison, recommendations []recommendation.Recommendation) {
	@layouts.Base("Recommendations") {
		<div>
			<div class="flex justify-between items-center mb-4">
				<a href={ templ.SafeURL(fmt.Sprintf("/comparisons/%d", c.ID)) } class="text-blue-600 hover:text-blue-800">← Back to Comparison</a>
			</div>
			<!-- Header -->
			<div class="bg-white rounded-lg shadow p-6 mb-6">
				<h1 class="text-2xl font-bold mb-2">Recommendations for { c.Creator.Name }</h1>
				<p class="text-gray-600 mb-4">Based on what { c.Comparator.Name } has watched but you haven't</p>
				<div class="text-sm text-gray-600 space-y-2">
					<p class="font-semibold">Score Formula:</p>
					<div class="ml-4 space-y-1">
						<div><strong>Alignment (40%)</strong>: How comparator's rating compares to average</div>
						<div><strong>Quality (30%)</strong>: 90% actual score + 5% popularity + 5% favorites</div>
						<div><strong>Relevance (30%)</strong>: 50% comparator score + 25% genre match + 25% tag match</div>
					</div>
					<div class="mt-3 p-3 bg-blue-50 rounded">
						<p class="text-xs font-semibold text-blue-800">How it works:</p>
						<p class="text-xs text-blue-700">We analyze which genres/tags you scored highly, then recommend media with those same genres/tags that { c.Comparator.Name } enjoyed.</p>
					</div>
				</div>
			</div>
			<!-- Recommendations Table -->
			<div class="bg-white rounded-lg shadow p-6">
				<h2 class="text-xl font-bold mb-4">Top Recommendations ({ fmt.Sprintf("%d", len(recommendations)) })</h2>
				if len(recommendations) == 0 {
					<p class="text-gray-500 text-center py-8">No recommendations found. { c.Comparator.Name } hasn't watched anything you haven't!</p>
				} else {
					<div class="overflow-x-auto">
						<table class="w-full">
							<thead class="bg-gray-50">
								<tr class="border-b-2 border-gray-200">
									<th class="text-left p-3 font-semibold">Title & Matching Genres/Tags</th>
									<th class="text-center p-3 font-semibold">Rec Score</th>
									<th class="text-center p-3 font-semibold">{ c.Comparator.Name } Score</th>
									<th class="text-center p-3 font-semibold">Avg Score</th>
									<th class="text-center p-3 font-semibold">
										<div>Breakdown</div>
										<div class="text-xs font-normal text-gray-500">(A=Alignment, Q=Quality, R=Relevance)</div>
										<div class="text-xs font-normal text-gray-500">(G=Genre Match, T=Tag Match)</div>
									</th>
								</tr>
							</thead>
							<tbody>
								for _, rec := range recommendations {
									@recommendationRow(rec)
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	}
}

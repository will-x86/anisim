package components

import (
	"fmt"
	"github.com/will-x86/anisim/internal/analyzer"
	"github.com/will-x86/anisim/internal/db"
	"github.com/will-x86/anisim/internal/types"
)

// render score with color
templ scoreDisplay(score float64) {
	if score == 0 {
		<span class="text-gray-400 text-lg">-</span>
	} else if score >= 7 {
		<span class="text-green-600 font-bold text-lg">{ fmt.Sprintf("%.1f", score) }</span>
	} else if score >= 5 {
		<span class="text-yellow-600 font-bold text-lg">{ fmt.Sprintf("%.1f", score) }</span>
	} else {
		<span class="text-red-600 font-bold text-lg">{ fmt.Sprintf("%.1f", score) }</span>
	}
}

// render status badge
templ statusBadge(status string) {
	switch status {
		case "COMPLETED":
			<span class="px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800 uppercase">{ status }</span>
		case "CURRENT":
			<span class="px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 uppercase">{ status }</span>
		case "PLANNING":
			<span class="px-3 py-1 rounded-full text-xs font-semibold bg-purple-100 text-purple-800 uppercase">{ status }</span>
		case "DROPPED":
			<span class="px-3 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-800 uppercase">{ status }</span>
		case "PAUSED":
			<span class="px-3 py-1 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-800 uppercase">{ status }</span>
		default:
			<span class="px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-800 uppercase">{ status }</span>
	}
}

// media table row
templ sharedMediaRow(entry analyzer.SharedEntry, mediaType string) {
	// mediaType is either "ANIME" or "MANGA"
	{{
		url := "#"
		title := entry.Media.Title.English
		if title == "" {
			title = entry.Media.Title.Romaji
		}
		switch mediaType {
		case "ANIME":
			url = fmt.Sprintf("https://anilist.co/anime/%d", entry.MediaID)
		case "MANGA":
			url = fmt.Sprintf("https://anilist.co/manga/%d", entry.MediaID)
		}
	}}
	<tr class="border-b hover:bg-gray-50 transition-colors">
		<td class="p-3">
			<a href={ templ.URL(url) } target="_blank" rel="noopener noreferrer" class="flex items-center gap-3">
				<img
					src={ entry.Media.CoverImage.Large }
					alt={ title }
					class="w-16 h-24 object-cover rounded-md shadow-sm"
				/>
				<div class="font-medium">{ title }</div>
			</a>
		</td>
		<td class="text-center p-3">
			@scoreDisplay(entry.CreatorScore)
		</td>
		<td class="text-center p-3">
			@scoreDisplay(entry.ComparatorScore)
		</td>
		<td class="text-center p-3">
			@statusBadge(entry.CreatorStatus)
		</td>
		<td class="text-center p-3">
			@statusBadge(entry.ComparatorStatus)
		</td>
	</tr>
}

templ ComparisonCard(c db.Comparison) {
	<div class="bg-white rounded-lg border hover:border-blue-400 hover:shadow transition p-4">
		<div class="flex justify-between items-center gap-4">
			<div class="space-y-2">
				<div class="font-medium">
					{ c.CreatorUsername }
					<span class="text-gray-400 mx-2">vs</span>
					{ c.ComparatorUsername }
				</div>
				<div class="text-sm text-gray-500">
					{ c.ComparisonDate.Time.Format("Jan 2, 2006") }
				</div>
			</div>
			<a
				href={ templ.SafeURL(fmt.Sprintf("/comparisons/%d", c.ID)) }
				class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-xl font-medium transition"
			>
				View
			</a>
		</div>
	</div>
}

templ CreateComparisonForm() {
	<form method="POST" action="/comparisons" class="space-y-4">
		<div class="grid md:grid-cols-2 gap-4">
			<input
				type="text"
				name="creator_username"
				placeholder="Your AniList username"
				required
				class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none"
			/>
			<input
				type="text"
				name="comparator_username"
				placeholder="Their AniList username"
				required
				class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none"
			/>
		</div>
		<button
			type="submit"
			class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 rounded-lg font-medium transition"
		>
			Compare Lists
		</button>
	</form>
}

templ ComparisonView(c types.Comparison, result analyzer.ComparisonResult) {
	<div class="bg-white rounded-lg shadow p-6 mb-6">
		<h1 class="text-2xl font-bold mb-6 text-center">Comparison Results</h1>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			<div class="flex items-center gap-4 border rounded-lg p-4">
				<img src={ c.Creator.Avatar.Medium } alt={ c.Creator.Name } class="w-16 h-16 rounded-full"/>
				<div>
					<h2 class="text-xl font-bold">{ c.Creator.Name }</h2>
					<div class="text-sm text-gray-600">{ fmt.Sprintf("%d", c.Creator.Statistics.Anime.EpisodesWatched) } episodes watched</div>
					<div class="text-sm text-gray-600">{ fmt.Sprintf("%d", c.Creator.Statistics.Manga.ChaptersRead) } chapters read</div>
				</div>
			</div>
			<div class="flex items-center gap-4 border rounded-lg p-4">
				<img src={ c.Comparator.Avatar.Medium } alt={ c.Comparator.Name } class="w-16 h-16 rounded-full"/>
				<div>
					<h2 class="text-xl font-bold">{ c.Comparator.Name }</h2>
					<div class="text-sm text-gray-600">{ fmt.Sprintf("%d", c.Comparator.Statistics.Anime.EpisodesWatched) } episodes watched</div>
					<div class="text-sm text-gray-600">{ fmt.Sprintf("%d", c.Comparator.Statistics.Manga.ChaptersRead) } chapters read</div>
				</div>
			</div>
		</div>
	</div>
	<div class="bg-white rounded-lg shadow p-6 mb-6">
		<div class="flex flex-wrap items-center justify-between gap-4">
			<div class="text-sm text-gray-500">
				Created: { c.Created.Format("January 2, 2006 at 3:04 PM") }
			</div>
			<div class="flex items-center gap-4">
				<a
					href="#manga-table"
					class="bg-blue-500 text-white px-4 py-2 hover:bg-blue-600 rounded-md text-sm"
				>Jump to Shared Manga</a>
				<form method="POST" action="/comparisons" class="inline">
					<input type="hidden" name="creator_username" value={ c.CreatorUsername }/>
					<input type="hidden" name="comparator_username" value={ c.ComparatorUsername }/>
					<button type="submit" class="bg-blue-500 text-white px-4 py-2 hover:bg-blue-700 rounded-md text-sm">
						Refresh Comparison
					</button>
				</form>
			</div>
		</div>
	</div>
	<!-- Anime Table -->
	<div class="bg-white rounded-lg shadow p-6 mb-6">
		<h2 class="text-xl font-bold mb-4">Shared Anime</h2>
		if len(result.AllSharedAnime) == 0 {
			<p class="text-gray-500 text-center py-8">No shared anime found</p>
		} else {
			<div class="overflow-x-auto">
				<table class="w-full rounded">
					<thead class="bg-gray-50">
						<tr class="border-b-2 border-gray-200">
							<th class="text-left p-3 font-semibold">Title</th>
							<th class="text-center p-3 font-semibold">{ c.Creator.Name } Score</th>
							<th class="text-center p-3 font-semibold">{ c.Comparator.Name } Score</th>
							<th class="text-center p-3 font-semibold">{ c.Creator.Name } Status</th>
							<th class="text-center p-3 font-semibold">{ c.Comparator.Name } Status</th>
						</tr>
					</thead>
					<tbody>
						for _, entry := range result.AllSharedAnime {
							@sharedMediaRow(entry, "ANIME")
						}
					</tbody>
				</table>
			</div>
		}
	</div>
	<!-- Manga Table -->
	<div id="manga-table" class="bg-white rounded-lg shadow p-6 mb-6">
		<h2 class="text-xl font-bold mb-4">Shared Manga</h2>
		if len(result.AllSharedManga) == 0 {
			<p class="text-gray-500 text-center py-8">No shared manga found</p>
		} else {
			<div class="overflow-x-auto">
				<table class="w-full">
					<thead class="bg-gray-50">
						<tr class="border-b-2 border-gray-200">
							<th class="text-left p-3 font-semibold">Title</th>
							<th class="text-center p-3 font-semibold">{ c.Creator.Name } Score</th>
							<th class="text-center p-3 font-semibold">{ c.Comparator.Name } Score</th>
							<th class="text-center p-3 font-semibold">{ c.Creator.Name } Status</th>
							<th class="text-center p-3 font-semibold">{ c.Comparator.Name } Status</th>
						</tr>
					</thead>
					<tbody>
						for _, entry := range result.AllSharedManga {
							@sharedMediaRow(entry, "MANGA")
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}
